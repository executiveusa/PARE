# PARÉ Environment Configuration Template
# (NAMES ONLY — NEVER COMMIT REAL VALUES)

# Server Ingress & Authentication
NODE_ENV=production
OD_BIND_HOST=0.0.0.0
OD_PORT=7456
OD_WEB_PORT=7456
OD_DATA_DIR=/app/.od
PARE_API_TOKEN=your-random-64-char-hex-token
OD_API_TOKEN=your-random-64-char-hex-token
OD_ALLOWED_ORIGINS=https://pauli-para.netlify.app,https://pare-api.thepaulieffect.com

# Sovereign Secret Bootstrap (Infisical)
PARE_BOOTSTRAP_SECRET=your-infisical-service-token
INFISCAL_API_TOKEN=your-infisical-service-token
INFISICAL_WORKSPACE_ID=your-infisical-workspace-id

# Local Fallback Provider Credentials (Optional when Bootstrap Secret is set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GH_PAT=
