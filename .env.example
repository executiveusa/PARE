# PARÉ Environment Configuration Template
# NAMES / EXAMPLE SHAPES ONLY — NEVER COMMIT REAL VALUES.

# Server ingress & authentication
NODE_ENV=production
OD_BIND_HOST=0.0.0.0
OD_PORT=7456
OD_WEB_PORT=7456
OD_DATA_DIR=/app/.od
OD_PUBLIC_BASE_URL=https://api.thepaulieffect.com/pare
PARE_API_TOKEN=your-random-64-char-hex-token
OD_API_TOKEN=your-random-64-char-hex-token
OD_ALLOWED_ORIGINS=https://pauli-para.netlify.app,https://deploy-preview-5--pauli-para.netlify.app,https://api.thepaulieffect.com

# Remote MCP gateway
PARE_MCP_BIND_HOST=0.0.0.0
PARE_MCP_PORT=7457
PARE_DAEMON_INTERNAL_URL=http://pare-daemon:7456
PARE_MCP_TOKEN=use-a-separate-long-random-token-for-private-mcp-access

# Sovereign secret bootstrap (Infisical)
PARE_BOOTSTRAP_SECRET=your-infisical-service-token
INFISCAL_API_TOKEN=your-infisical-service-token
INFISICAL_WORKSPACE_ID=your-infisical-workspace-id

# Local fallback provider credentials
# Optional when the Infisical resolver can supply the same provider key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
GH_PAT=

# Agent/MCP compatibility environment
# `od mcp` is a stdio MCP server that calls a reachable PARÉ daemon.
# A run-scoped OD_TOOL_TOKEN is preferred for project tool access; do not
# hard-code tool grants in this file for production.
OD_DAEMON_URL=https://api.thepaulieffect.com/pare
OD_TOOL_TOKEN=

# Browser deployment
# The web app normally uses same-origin `/api/*` rewrites to the sovereign VPS.
# Do not place PARE_API_TOKEN, PARE_MCP_TOKEN, provider keys, or Infisical tokens in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_PARE_API_ORIGIN=https://api.thepaulieffect.com/pare
